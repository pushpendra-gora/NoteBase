# Supabase Cloud Database & Storage Credentials for NoteBase
# Get your Project URL and anon public key from: Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Google Drive Web App URL (Optional)
NEXT_PUBLIC_GOOGLE_DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_ID=

# Admin Initial Credentials (Optional)
NEXT_PUBLIC_ADMIN_DEFAULT_ID=admin
NEXT_PUBLIC_ADMIN_DEFAULT_PASSWORD=admin123
