# ==============================================================================
# NOTEBASE - LOCAL ENVIRONMENT VARIABLES EXAMPLE (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE (PUBLIC)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY (PRIVATE SECRETS - NO NEXT_PUBLIC_ PREFIX)
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_DRIVE_FOLDER_ID=

ADMIN_DEFAULT_ID=admin
ADMIN_DEFAULT_PASSWORD=admin123

# (Optional) Backend only
SUPABASE_SERVICE_ROLE_KEY=
