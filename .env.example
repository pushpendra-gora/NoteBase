# ==============================================================================
# NOTEBASE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` for local development.
# On Vercel: Add these variables under Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (PUBLIC - SAFE FOR BROWSER BUNDLE)
# ------------------------------------------------------------------------------
# Get these from: Supabase Dashboard -> Project Settings -> API
# Required for connecting the frontend to your Supabase PostgreSQL database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (PRIVATE - NEVER EXPOSED TO CLIENT JAVASCRIPT)
# ------------------------------------------------------------------------------
# DO NOT ADD NEXT_PUBLIC_ PREFIX TO ANY OF THE VARIABLES BELOW!
# These are kept strictly on the Node.js / Next.js server for maximum security.

# Google Drive Webhook Integration (Optional / Recommended)
# The Google Apps Script Web App URL used by /api/upload-drive on the server.
GOOGLE_DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec

# (Optional) Target Google Drive Folder ID where uploaded PDFs should be saved.
# Leave blank to automatically save in a folder named "College Notes App Uploads".
GOOGLE_DRIVE_FOLDER_ID=

# Default Administrator Credentials (Optional)
# Used server-side by /api/admin/auth as initial credentials when database is not yet seeded.
ADMIN_DEFAULT_ID=admin
ADMIN_DEFAULT_PASSWORD=admin123

# (Optional) Supabase Service Role Secret Key
# Private key with full administrative privileges. Keep secret on server only.
SUPABASE_SERVICE_ROLE_KEY=
