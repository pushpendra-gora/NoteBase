# ==============================================================================
# NOTEBASE - ENVIRONMENT VARIABLES (FOR VERCEL & LOCAL DEV)
# ==============================================================================
# Instructions for Vercel:
# 1. Go to your Project on Vercel Dashboard -> Settings -> Environment Variables.
# 2. Add each variable below with your actual values.
# 3. For local development, copy this file to `.env.local` and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# 2. GOOGLE DRIVE PDF UPLOAD INTEGRATION (OPTIONAL / RECOMMENDED)
# ------------------------------------------------------------------------------
# If you are uploading PDFs to Google Drive using Google Apps Script:
# Deploy your Google Apps Script as a Web App (access: Anyone) and paste the URL:
NEXT_PUBLIC_GOOGLE_DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec

# (Optional) Target Folder ID in Google Drive where files should be saved.
# Leave blank to automatically save in a folder named "College Notes App Uploads".
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_ID=

# ------------------------------------------------------------------------------
# 3. DEFAULT ADMIN CREDENTIALS (OPTIONAL)
# ------------------------------------------------------------------------------
# Initial credentials used if database is empty or not yet seeded.
# You can change the admin password anytime from the Admin Portal.
NEXT_PUBLIC_ADMIN_DEFAULT_ID=admin
NEXT_PUBLIC_ADMIN_DEFAULT_PASSWORD=admin123
